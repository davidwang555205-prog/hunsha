# ========== bridal 应用配置（Go 后端 config.go applyBridalEnvDefaults 读取）==========
WALA_API_KEY=replace_with_walaapi_key
WALA_API_BASE_URL=https://walaapi.net/v1
WALA_IMAGE_MODEL=gpt-image-2
WALA_IMAGE_QUALITY=medium
WALA_IMAGE_TIMEOUT_MS=180000
WALA_IMAGE_RETRY_ATTEMPTS=3
# 单次生图传 WalaAPI 参考图张数上限（场景图 + 连续性参考图 + 产品图按优先级截断）。Node 时代硬编码 4，默认 8，实测后调整。
WALA_IMAGE_REFERENCE_LIMIT=8
APP_ADMIN_PASSWORD=admin123
APP_USER_PASSWORD=user123
DEFAULT_DAILY_IMAGE_LIMIT=20
HISTORY_RETENTION_DAYS=180

# ========== 团队初始化（team.initTeam 读，建初始 enterprise 管理员账号，bcrypt）==========
# bridal 切 team 认证后，登录用此 email + password。留空则跳过初始化。
# 旧 bridalauth 的 admin/wang（username+scrypt）账号无法用此登录，需用本配置重建。
MCAI_INIT_TEAM_EMAIL=admin@example.com
MCAI_INIT_TEAM_PASSWORD=admin123
MCAI_INIT_TEAM_NAME=管理员

# ========== PostgreSQL（docker-compose 读取起容器；后端连接 DSN 见 backend/config/server/config.yaml database.master）==========
PG_PORT=5432
PG_DB=bridal
PG_USER=bridal
PG_PASSWORD=change_me

# ========== MinIO / S3（docker-compose 读取起容器；后端 OSS 配置见 config.yaml object_storage）==========
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me

# ========== Redis（docker-compose 读取起容器；后端 Redis 配置见 config.yaml redis）==========
REDIS_PORT=6379
REDIS_PASSWORD=change_me
